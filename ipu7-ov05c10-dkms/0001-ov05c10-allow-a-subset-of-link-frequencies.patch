ov05c10: allow a subset of the link frequencies

The stock ipu-bridge declares only 480 MHz for OVTI05C1, while the driver
insisted on both 900 and 480 MHz and failed the probe with -EINVAL. Keep
the modes whose frequency is advertised and hide the others (here: only
2800x1576@30 remains).

--- a/ov05c10.c
+++ b/ov05c10.c
@@ -606,7 +606,8 @@
 
 	ov05c10->link_freq = v4l2_ctrl_new_int_menu(ctrl_hdlr,
 		&ov05c10_ctrl_ops, V4L2_CID_LINK_FREQ,
-		ARRAY_SIZE(ov05c10_link_freq_menu_items) - 1, 0,
+		ARRAY_SIZE(ov05c10_link_freq_menu_items) - 1,
+		ov05c10->cur_mode->link_freq_index,
 		ov05c10_link_freq_menu_items);
 	if (ov05c10->link_freq)
 		ov05c10->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
@@ -742,6 +743,40 @@
 	fmt->field = V4L2_FIELD_NONE;
 }
 
+/*
+ * Only modes whose link frequency the firmware/bridge advertises are usable.
+ * The stock ipu-bridge declares just 480 MHz for OVTI05C1, so on a stock
+ * kernel the 900 MHz mode is hidden instead of failing the whole probe.
+ */
+static bool ov05c10_mode_ok(struct ov05c10 *ov05c10,
+			    const struct ov05c10_mode *mode)
+{
+	return ov05c10->link_freq_bitmap & BIT(mode->link_freq_index);
+}
+
+static const struct ov05c10_mode *ov05c10_find_mode(struct ov05c10 *ov05c10,
+						    u32 width, u32 height)
+{
+	const struct ov05c10_mode *best = NULL;
+	u32 dist, best_dist = U32_MAX;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(supported_modes); i++) {
+		const struct ov05c10_mode *mode = &supported_modes[i];
+
+		if (!ov05c10_mode_ok(ov05c10, mode))
+			continue;
+		dist = abs((int)mode->width - (int)width) +
+		       abs((int)mode->height - (int)height);
+		if (dist < best_dist) {
+			best = mode;
+			best_dist = dist;
+		}
+	}
+
+	return best;
+}
